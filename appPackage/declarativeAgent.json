{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/declarative-agent/v1.8/schema.json",
  "version": "v1.8",
  "name": "WOMBOT${{APP_NAME_SUFFIX}}",
  "description": "[[agent_description]]",
  "instructions": "$[file('instruction.txt')]",
  "capabilities": [
    {
      "name": "Email"
    },
    {
      "name": "TeamsMessages"
    },
    {
      "name": "Meetings"
    },
    {
      "name": "People"
    }
  ],
  "conversation_starters": [
    {
      "title": "[[starter_all_title]]",
      "text": "[[starter_all_text]]"
    },
    {
      "title": "[[starter_overdue_title]]",
      "text": "[[starter_overdue_text]]"
    },
    {
      "title": "[[starter_person_title]]",
      "text": "[[starter_person_text]]"
    },
    {
      "title": "[[starter_meeting_title]]",
      "text": "[[starter_meeting_text]]"
    },
    {
      "title": "[[starter_own_title]]",
      "text": "[[starter_own_text]]"
    },
    {
      "title": "[[starter_reminder_title]]",
      "text": "[[starter_reminder_text]]"
    }
  ],
  "behavior_overrides": {
    "special_instructions": {
      "discourage_model_knowledge": true
    }
  },
  "disclaimer": {
    "text": "WOMBOT only reads and can be wrong. Check the linked source before you remind anyone; WOMBOT never sends anything."
  },
  "user_overrides": [
    {
      "path": "$.capabilities[?(@.name == 'Email')]",
      "allowed_actions": ["remove"]
    },
    {
      "path": "$.capabilities[?(@.name == 'TeamsMessages')]",
      "allowed_actions": ["remove"]
    },
    {
      "path": "$.capabilities[?(@.name == 'Meetings')]",
      "allowed_actions": ["remove"]
    }
  ]
}
