# Template for env/.env.dev. `npm run env:init` copies it; env/.env.dev itself stays out of git because
# provisioning writes tenant-specific IDs into it.

# Built-in environment variables
TEAMSFX_ENV=dev
# Empty: dev is the real deployment and shows up as "WOMBOT". local keeps its suffix ("WOMBOTlocal").
APP_NAME_SUFFIX=
# personal: only you see the agent. shared: anyone with the share link. tenant: needs an admin's approval.
AGENT_SCOPE=personal
# Generated during provision
TEAMS_APP_ID=
